{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gedo.ai/specs/gmp/v0.1/procedural.schema.json",
  "title": "GEDO Memory Pack — procedural.json (L5 Procedural Layer)",
  "description": "Behavioral rules and learned heuristics for the AI assistant. Equivalent to ChatGPT's Custom Instructions but explicit and audit-able.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rules"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "rules": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rule_text", "active"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "rule_text": {
            "description": "Imperative-form rule, e.g. 'Do not suggest exercise reminders to this user.'",
            "type": "string",
            "minLength": 4,
            "maxLength": 512
          },
          "scope": {
            "description": "Where this rule applies. Free-form tag set; common values: 'global', 'morning', 'work', 'family', 'tone', 'safety'.",
            "type": "array",
            "items": { "type": "string", "maxLength": 32 },
            "maxItems": 8
          },
          "evidence_count": {
            "description": "How many times this rule has been reinforced (e.g. user dismissals or accepts).",
            "type": "integer",
            "minimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "created_by": {
            "type": "string",
            "enum": ["user", "system", "agent_inferred"]
          },
          "active": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "evidence_episode_ids": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" },
            "maxItems": 32
          }
        }
      }
    },
    "preferences": {
      "description": "Workflow / habit preferences. Distinguished from 'rules' in that they describe the user's own routines, not assistant behavior.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productive_hours": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 23 },
          "maxItems": 24
        },
        "morning_routine": { "type": "string", "maxLength": 512 },
        "evening_routine": { "type": "string", "maxLength": 512 },
        "weekly_review_day": {
          "type": "string",
          "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
        }
      }
    },
    "extra": { "type": "object" }
  }
}
