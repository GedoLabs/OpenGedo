# ==============================================================================
# Edition — oss (self-hosted) vs cloud (official site + SaaS)
# ==============================================================================
# Open-core 双仓制：开源仓 Gedolabs/gedo 自托管构建用 oss（营销页/Stripe/sim 全部关闭），
# 官方 SaaS 用 cloud（默认）。NEXT_PUBLIC_* 为构建期内联，改动需重新 build。
NEXT_PUBLIC_GEDO_EDITION=cloud

# 容器/自托管：SSR 与 /api rewrite 的后端源（compose 注入，如 http://backend:8787）。
# 本地开发留空，回退 http://localhost:8787。
# BACKEND_ORIGIN=

# ==============================================================================
# Stripe — 沙盒 / Test mode（与 stripe.com 控制台左上角「测试」一致）
# ==============================================================================
# 密钥与 Price 均来自测试模式 Dashboard：https://dashboard.stripe.com/test
# 生产环境请切换到「正式」模式，使用 sk_live_ / pk_live_ 及对应 Price ID。
#
# 本地开发：复制本文件为 `.env.local` 并填入真实值（`.env.local` 勿提交到 Git）。
# ==============================================================================

# API keys（测试模式以 sk_test_ / pk_test_ 开头）
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# 可选：在 Dashboard → Tax 完成设置后再开启自动计税
# STRIPE_TAX_ENABLED=true

# Webhook 签名密钥（测试模式）
# - 本地：`stripe listen --forward-to localhost:3000/api/stripe/webhook` 输出的 whsec_
# - 线上：在 Dashboard → Webhooks（测试）创建端点后复制签名密钥
STRIPE_WEBHOOK_SECRET=whsec_...

# ==============================================================================
# Stripe Price IDs
# 定价三端对齐 App Store（2026-07 定稿,USD;见 docs/PRICING_AND_STORE_LAUNCH.md）:
#   Pro   $9.99/mo · $99.99/yr    Ultra $29.99/mo · $299.99/yr
# 下方为旧价测试模式 Price(9.90/99/29.90/299)。上线前需在 Stripe live 按新价
# 重建 4 个 Price 并替换;Stripe 的 Price 不可改金额,只能新建后换 ID。
# ==============================================================================
# GEDO AI Pro Plan — target: US$9.99/mo, US$99.99/yr
STRIPE_PRICE_MONTHLY=price_1TNTmQFCej72GJUNwAs1JdUg
STRIPE_PRICE_YEARLY=price_1TNTmQFCej72GJUN9aeHhElA

# GEDO AI Ultra Plan — target: US$29.99/mo, US$299.99/yr
STRIPE_PRICE_ULTRA_MONTHLY=price_1TNBypFCej72GJUNIE5aGRSs
STRIPE_PRICE_ULTRA_YEARLY=price_1TNBypFCej72GJUNibPAnTws

# Forward Stripe webhooks to backend-api (optional but recommended)
# STRIPE_WEBHOOK_FORWARD_URL=http://localhost:8787/v1/billing/stripe/webhook
# STRIPE_WEBHOOK_FORWARD_TOKEN=your-shared-secret

# ==============================================================================
# Site URL（success/cancel/portal 跳转）
# ==============================================================================
NEXT_PUBLIC_SITE_URL=

# ==============================================================================
# Backend（可选：webhook 转发到自建 API 做订阅落库）
# ==============================================================================
NEXT_PUBLIC_API_BASE_URL=
STRIPE_WEBHOOK_FORWARD_URL=
STRIPE_WEBHOOK_FORWARD_TOKEN=

# ==============================================================================
# Social login — Google & Apple sign-in (client-side, public values only)
# ==============================================================================
# A button appears only when its provider is configured here; leave blank to hide.
# The backend (backend-api) must list the SAME client IDs in GOOGLE_CLIENT_IDS /
# APPLE_CLIENT_IDS so it accepts the tokens these mint. See backend env.example.
#
# Google: the "Web application" OAuth client ID from Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Apple: the Services ID (NOT the app bundle ID) + a return URL registered on it.
# For popup sign-in the return URL must still be an https origin you configured.
NEXT_PUBLIC_APPLE_SERVICES_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# ==============================================================================
# 平行人生 Parallel You（/sim）— 独立 LLM 配置，与产品后端完全隔离
# ==============================================================================
# 默认 anthropic；SIM_ANTHROPIC_API_KEY 缺省时回落 ANTHROPIC_API_KEY
SIM_PROVIDER=anthropic
SIM_ANTHROPIC_API_KEY=
# 回合生成模型（默认 Haiku，快且便宜）；终局报告可用更强模型
SIM_MODEL=claude-haiku-4-5-20251001
SIM_REPORT_MODEL=
# 本地开发代理（Anthropic 地区限制；生产留空直连）。缺省回落 HTTPS_PROXY
SIM_PROXY_URL=
# 每日全局 LLM 调用预算（营销成本熔断）
SIM_DAILY_BUDGET=1500
