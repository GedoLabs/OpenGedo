# GEDO.AI Backend API 环境变量示例
# 复制此文件为 .env 并填入实际值

# ══════════════════════════════════════════════════════════════════════
#  OSS 自托管最小配置（open-core: github.com/Gedolabs/gedo）
#  只需三行即可跑起来，其余全部可选：
#    GEDO_EDITION=oss
#    JWT_SECRET=<随机长字符串>
#    ANTHROPIC_API_KEY=<你的 key>          # BYOK；或用本地 Ollama：LLM_PROVIDER=ollama
#  可选增强：本地 Ollama embedding（语义召回，缺省自动退关键词检索）、
#  社交登录（GOOGLE_CLIENT_IDS/APPLE_CLIENT_IDS）、邮件（RESEND_API_KEY）。
#  受限地区自托管需配置代理，见下方「网络代理」段。
# ══════════════════════════════════════════════════════════════════════

# 服务器配置
PORT=8787
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Edition: oss = self-hosted（开放注册、无计费/邀请码/遥测）
#          cloud = official SaaS (default)
GEDO_EDITION=cloud

# ── Social login (Google / Apple Sign-In) ───────────────────────────────────
# The backend verifies provider ID tokens against Google/Apple's public JWKS and
# then checks the token's `aud` against the allow-lists below. List EVERY client
# ID that may mint a token you accept (comma-separated). Leave a var empty to
# disable that provider (its /v1/auth/* endpoint then returns 503).
# New Google/Apple accounts still require an invite code (REQUIRE_INVITE); a
# returning user, or one whose verified email already has an account, passes through.
#
# Google — one OAuth 2.0 Client ID per platform (Google Cloud Console → Credentials):
#   web     = "Web application" client — used on web AND as the mobile idToken audience
#   ios     = "iOS" client        android = "Android" client
#   (mobile google-signin is configured with the WEB client id, so its tokens carry
#    the web client id as aud — but list all three to be safe.)
# GOOGLE_CLIENT_IDS=REPLACE-web.apps.googleusercontent.com,REPLACE-ios.apps.googleusercontent.com,REPLACE-android.apps.googleusercontent.com
#
# Apple — the iOS app's Bundle ID (native) AND the web Services ID. Both are valid auds.
# APPLE_CLIENT_IDS=ai.gedo.app,ai.gedo.web

# Public base URL for digital persona links (self-hosted: your domain, e.g. https://app.example.com)
# PUBLIC_BASE_URL=https://app.example.com

# CORS 配置
CORS_ORIGIN=http://localhost:3000

# 数据库配置（PostgreSQL + pgvector）
USE_POSTGRES=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gedoai
POSTGRES_USER=gedo
POSTGRES_PASSWORD=gedo_dev_password
POSTGRES_POOL_MAX=10

# LLM 配置
ENABLE_LLM=true
# 对话主模型：anthropic / claude（默认）或 openai / gpt（走 GPT 主通道、Claude 作降级）
LLM_PROVIDER=anthropic

# 网络代理（仅受限地区本地开发需要；生产环境/海外机房留空即可，自动直连）
# Node 内置 fetch 默认不读 HTTPS_PROXY，会直连官方 API 被地区限制 403。
# 设下面任一即可让 LLM 调用走代理（仅作用于 Anthropic/OpenAI，不影响本地 Ollama）。
# 通用：一条管两家
# HTTPS_PROXY=http://127.0.0.1:7897
# 单独控制（优先于 HTTPS_PROXY）；设 off/none 可强制某家直连
# ANTHROPIC_PROXY=http://127.0.0.1:7897
# OPENAI_PROXY=off

# Anthropic 配置（主力 - Claude）
# ANTHROPIC_API_KEY：控制台或渠道方提供的密钥
# ANTHROPIC_BASE_URL：可选。官方默认可不填；第三方兼容网关 / 代理时填其根地址（勿以 / 结尾也可）
ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=4096
# ANTHROPIC_TIMEOUT_MS=600000

# OpenAI 配置（辅助 - Embedding + 备用对话）
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_MAX_TOKENS=4096

# Ollama 配置（本地部署 - 可选）
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_EMBED_MODEL=bge-m3

# ── 智忆 Embedding（语义召回，P1）─────────────────────────────────
# 默认本地优先：Ollama + bge-m3（1024 维），敏感长期记忆不出本机、成本低。
# 切换 provider / 模型 / 维度后必须全量 backfill 重算（npm run backfill:embeddings），
# 禁止混用不同维度的向量。
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
# OLLAMA_BASE_URL=http://localhost:11434   # 见上（embedding 复用）
# 云端可选（质量升级；需全量重算）：openai | siliconflow | qwen3-embedding
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# EMBEDDING_BASE_URL=   # 自定义 OpenAI 兼容端点（siliconflow/qwen 等）
# EMBEDDING_API_KEY=    # 对应 provider 的 key

# DeepSeek 配置（可选）
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-api-key

# 对象存储配置（Cloudflare R2）
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET_NAME=gedoai-uploads

# ── Feature Flags ─────────────────────────────────────────────────────────────
# 默认：CHAT_FIRST_UI / GENUI_V1 开启（非 false 即为开）
# 其余 flag 默认关闭（需显式 =true 开启）
FEATURE_CHAT_FIRST_UI=true
FEATURE_GENUI_V1=true
FEATURE_PROACTIVE=false          # P2-B 主动 Agent（隐私优先，默认关）
FEATURE_LAYERED_MEMORY=false     # P3-A L1-L5 记忆层（需先跑 db:migrate）
FEATURE_HYBRID_V2=false          # P3-B 4路检索+RRF（需 pgvector + fts 列就绪）
FEATURE_PERSONA_AS_MODE=false    # P3-C AS/ABOUT 人格模式（用户显式 opt-in）

# ── Reranker (P3-B) ───────────────────────────────────────────────────────────
# COHERE_API_KEY=your-cohere-api-key          # 若不填，降级到 LLM rerank / TSS
# COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# ── Web Push / VAPID (P2-C) ───────────────────────────────────────────────────
# 生成命令: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:admin@gedo.ai

# ── pg-boss (P2-A) ────────────────────────────────────────────────────────────
# 与 POSTGRES_* 复用同一连接；PGBOSS_SCHEMA 默认 pgboss
# PGBOSS_SCHEMA=pgboss


















# ── Transactional email (Resend) ─────────────────────────────────────────────
# Powers verify-email, password reset, subscription receipts & security notices.
# Cloud only — self-hosted/OSS runs fine without it (email calls no-op).
RESEND_API_KEY=                             # from resend.com; required to send
EMAIL_FROM=GEDO <no-reply@mail.gedo.ai>     # must be on a Resend-verified domain
EMAIL_REPLY_TO=support@gedo.ai              # optional
APP_PUBLIC_URL=https://app.gedo.ai          # base for verify/reset links (falls back to CORS_ORIGIN)
# EMAIL_ENABLED=false                       # hard kill switch (default on when key present)
# RESEND_PROXY_URL=                         # explicit-only; NEVER inherits HTTPS_PROXY (Resend is direct-reachable)
# BILLING_MANAGE_URL=                       # where receipt/manage buttons point (default APP_PUBLIC_URL/app/account)
API_PUBLIC_URL=                             # backend public base (e.g. https://api.gedo.ai); enables one-click List-Unsubscribe in P1 emails

# ── Billing webhooks (cloud only) ─────────────────────────────────────────────
# Stripe events arrive pre-verified from the web container (see web/.env STRIPE_WEBHOOK_FORWARD_URL).
# Same shared-secret must be set on both sides; unset = accept without auth (dev only).
STRIPE_WEBHOOK_FORWARD_TOKEN=
# RevenueCat → POST /v1/billing/revenuecat/webhook. In the RC dashboard set the
# webhook Authorization header to exactly: Bearer <this value>.
REVENUECAT_WEBHOOK_TOKEN=
